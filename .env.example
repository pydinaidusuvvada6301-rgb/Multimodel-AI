# ==========================================
# OmniMind AI — Root Environment Template
# ==========================================

# Backend Configuration (backend/.env)
NODE_ENV=development
PORT=5000
API_BASE_URL=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Supabase & Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT & Authentication
JWT_ACCESS_SECRET=replace_with_a_super_secret_64_character_key_min
JWT_ACCESS_TTL=15m
JWT_ISSUER=omnimind-api
JWT_AUDIENCE=omnimind-client
REFRESH_TOKEN_TTL_DAYS=30

# Google Gemini Official SDK
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# File Storage & Limits
STORAGE_BUCKET=omnimind-private
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_RETRIEVAL_CHUNKS=12

# AI Orchestration Limits
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT_REQUESTS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend Configuration (frontend/.env)
# VITE_API_BASE_URL=http://localhost:5000/api/v1
