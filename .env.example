# ==============================================================================
# OmniMind AI — Environment Configuration Checklist (.env.example)
# Only placeholder values are included. Never commit actual secret keys.
# ==============================================================================

# Core Application Server
NODE_ENV=production
PORT=5000
API_BASE_URL=/api/v1
CLIENT_ORIGIN=https://multimodel-ai-mu.vercel.app
CORS_ORIGINS=https://multimodel-ai-mu.vercel.app,http://localhost:5173

# Database & Supabase Integration (PostgreSQL + RLS)
# Obtain from https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Direct PostgreSQL connection pool string (optional if direct connection preferred)
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres?sslmode=require

# Google Gemini Official SDK (@google/genai)
# Obtain key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Session & JWT Security
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_ACCESS_TTL=15m
JWT_ISSUER=omnimind-api
JWT_AUDIENCE=omnimind-client
REFRESH_TOKEN_TTL_DAYS=30

# Private Object Storage & Limits
STORAGE_BUCKET=omnimind-private
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_RETRIEVAL_CHUNKS=12

# AI Orchestration Limits & Rate Limiting
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info

# Frontend Configuration (Vercel / frontend/.env)
# VITE_API_BASE_URL=https://omnimind-backend.onrender.com/api/v1
# VITE_APP_TITLE=OmniMind AI
