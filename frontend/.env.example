# ==============================================================================
# OmniMind AI — Frontend Client Environment Template (.env.example)
# Copy this file to .env in the frontend directory: cp .env.example .env
# ==============================================================================

# API Base URL
# - In local Vite dev: uses Vite proxy if set to '/api/v1' or connects directly via 'http://localhost:5000/api/v1'
# - In production: set to your deployed backend domain (e.g. 'https://omnimind-backend.onrender.com/api/v1')
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase Public Client Credentials (Anon key only, NEVER service-role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Identity & Branding
VITE_APP_TITLE=OmniMind AI
VITE_APP_DESCRIPTION=One Workspace. Every Modality. Connected Intelligence.

# Client Feature Flags
VITE_ENABLE_MOCK_DEMO_LOGIN=true
