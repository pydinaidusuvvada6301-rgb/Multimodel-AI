# ==============================================================================
# OmniMind AI — Backend Server Environment Template (.env.example)
# Copy this file to .env in the backend directory: cp .env.example .env
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Supabase Configuration
# (Add SUPABASE_URL and at least one key: SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT & Authentication Security (Minimum 32 characters for secret)
JWT_ACCESS_SECRET=replace_with_a_super_secret_64_character_key_min
JWT_ACCESS_TTL=15m
JWT_ISSUER=omnimind-api
JWT_AUDIENCE=omnimind-client
REFRESH_TOKEN_TTL_DAYS=30

# Google Gemini AI Official SDK (@google/genai)
# Obtain your free or pay-as-you-go key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Object Storage & Upload Limits
STORAGE_BUCKET=omnimind-private
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_RETRIEVAL_CHUNKS=12

# AI Orchestration Resilience & Concurrency
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT_REQUESTS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# System Logging
LOG_LEVEL=info
